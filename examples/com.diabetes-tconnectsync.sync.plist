<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tandem Source -> Mini Nightscout, hourly at :35 America/Chicago (same minute the
  GCP timer used). Credentials from Keychain at run time. Not RunAtLoad, so
  installing never fires an extra upload. Installed by examples/install-launchagents.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.diabetes-tconnectsync.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_REPO/tconnectsync/diabetes-tconnectsync</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>35</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>REPLACE_HOME</string>
    <key>TZ</key>
    <string>America/Chicago</string>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_HOME/Library/Logs/diabetes-tconnectsync.sync.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/Library/Logs/diabetes-tconnectsync.sync.log</string>
</dict>
</plist>
