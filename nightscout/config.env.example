# ~/.diabetes-data/nightscout/config.env — optional, non-secret overrides (KEY=VALUE).
# Secrets never go here: API_SECRET and the Dexcom Share login live in Keychain.
# After editing: launchctl kickstart -k gui/$(id -u)/com.diabetes-nightscout.server

# LAN bind. 0.0.0.0 = home LAN + Tailscale. Never port-forward this port.
#DIABETES_NIGHTSCOUT_HOST=0.0.0.0
#DIABETES_NIGHTSCOUT_PORT=8425

# Dexcom Share bridge. Turn on only when no other Nightscout polls Share.
# Needs Keychain service diabetes-nightscout, accounts dexcom-username and dexcom-password.
#BRIDGE_ENABLE=1
#BRIDGE_SERVER=US
