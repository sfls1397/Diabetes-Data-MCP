#!/bin/sh
set -eu
HOME_DIR=${DIABETES_TCONNECTSYNC_HOME:-$HOME/.diabetes-data/tconnectsync}
HERE=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
PY=$HOME_DIR/venv/bin/python
BIN=$HOME_DIR/venv/bin/tconnectsync
test -x "$BIN" || { /usr/bin/python3 "$HERE/../sync/failure_diagnostics.py" startup unknown; exit 1; }

k() { security find-generic-password -s "$1" -a "$2" -w 2>/dev/null; }
{ [ -n "${TCONNECT_EMAIL:-}" ] || TCONNECT_EMAIL=$(k diabetes-tconnectsync tconnect-email); } &&
{ [ -n "${TCONNECT_PASSWORD:-}" ] || TCONNECT_PASSWORD=$(k diabetes-tconnectsync tconnect-password); } &&
{ [ -n "${PUMP_SERIAL_NUMBER:-}" ] || PUMP_SERIAL_NUMBER=$(k diabetes-tconnectsync pump-serial-number); } &&
{ [ -n "${NS_SECRET:-}" ] || NS_SECRET=$(k diabetes-sqlite api-secret); } || {
  /usr/bin/python3 "$HERE/../sync/failure_diagnostics.py" 'credential lookup' auth; exit 2; }

export TCONNECT_EMAIL TCONNECT_PASSWORD PUMP_SERIAL_NUMBER NS_SECRET
export NS_URL=${NS_URL:-http://127.0.0.1:8425}
export TCONNECT_REGION=${TCONNECT_REGION:-US}
export TIMEZONE_NAME=${TIMEZONE_NAME:-America/Chicago}

cd "$HOME_DIR" 2>/dev/null || { /usr/bin/python3 "$HERE/../sync/failure_diagnostics.py" startup unknown; exit 1; }
if [ ! -f "$PY" ] || [ ! -x "$PY" ]; then
  status=0
  (exec "$PY") 2>/dev/null || status=$?
  /usr/bin/python3 "$HERE/../sync/failure_diagnostics.py" startup unknown
  exit "$status"
fi
if [ "${1:-}" = enrich ]; then
  shift
  exec "$PY" "$HERE/enrich_combos.py" "$@"
fi
[ $# -gt 0 ] || set -- --catch-up --features BASAL BOLUS PUMP_EVENTS PROFILES
exec "$PY" "$HERE/diabetes_tconnectsync.py" "$@"
