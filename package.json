{
  "name": "diabetes-data-mcp",
  "version": "1.1.2",
  "description": "Mac Mini diabetes data plane: LAN-only Nightscout (LaunchAgents, loopback MongoDB), the Nightscout to SQLite sync, and a read-only bearer-token Streamable HTTP MCP over that archive",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "diabetes-data-mcp": "./bin/diabetes-data-mcp.js"
  },
  "author": "sfls1397",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfls1397/Diabetes-Data-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/sfls1397/Diabetes-Data-MCP/issues"
  },
  "homepage": "https://github.com/sfls1397/Diabetes-Data-MCP#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nightscout",
    "diabetes",
    "cgm",
    "sqlite",
    "macos"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "dist/",
    "bin/",
    "sync/",
    "nightscout/",
    "tconnectsync/",
    "examples/",
    "!**/__pycache__/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan:package": "node scripts/scan-package.js",
    "prepublishOnly": "npm run security:check && npm run build && npm run scan:package",
    "security:check": "python3 .security/scan.py all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
